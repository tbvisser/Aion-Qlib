# Hermes gateway sidecar. Copy to hermes/.env (gitignored) and fill in.
#
# The entrypoint merges these into /opt/data/.env inside the container.
# You can also rely on webapp/.env via docker-compose env_file — keys with
# the same name (OPENROUTER_API_KEY, AION_MCP_TOKEN, VIBE_API_TOKEN) are
# forwarded automatically when listed in compose.

# --- LLM (Hermes itself — separate billing from Aion chat) ------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Aion MCP + Vibe MCP (must match webapp/.env) ---------------------------
AION_MCP_TOKEN=
VIBE_API_TOKEN=

# --- Optional messaging (leave blank to run gateway without chat channels) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# DISCORD_BOT_TOKEN=

# --- Optional dashboard (binds :9119 inside container when enabled) -----------
# HERMES_DASHBOARD=1
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=aion
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me

# --- Linux host UID/GID (file ownership on the named volume) ----------------
# HERMES_UID=1000
# HERMES_GID=1000
