# --- AION fork additions ---------------------------------------------------

# Local virtualenv. uv happens to write .venv/.gitignore containing "*", which
# hides this today, but a venv created any other way would stage ~1.2 GB.
.venv/
venv/

# CatBoost writes these next to the working directory on every fit; they are run
# artifacts, not source.
catboost_info/
examples/catboost_info/

# docker compose reads this for AION_IMAGE / DOCKER_UID. See .env.example.
# (The bare `.env` rule above is upstream's; repeated here for the same reason.)
.env
.env.local

# The Supabase stack (auth + Postgres) now lives in the repo so the whole
# platform starts from one directory -- see infra/README.md. It is *not* ours to
# version: it is an upstream compose project carrying its own .env full of keys,
# a live Postgres data directory, and the storage bucket contents. Ignoring it
# addresses the reason rag/INSTALL.md advises keeping Supabase outside a repo.
infra/supabase/
