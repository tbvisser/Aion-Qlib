# Vibe-Trading sidecar configuration. Copy to vibe/.env (gitignored) and fill in.
# Read by the vibe-api and vibe-mcp containers only — nothing here ever reaches
# the browser or the qlib API image.

# ── Required for the compose stack ──────────────────────────────────────────
# The vibe API rejects non-loopback requests unless this key is set, and the
# qlib API's proxy connects over the docker network (non-loopback). Set the SAME
# value as VIBE_API_TOKEN in webapp/.env so the proxy can authenticate
# (Authorization: Bearer <key>).
API_AUTH_KEY=

# ── Agent LLM (needed for agent sessions / swarms; not for data or MCP tools) ─
# Any one provider is enough. The [anthropic] extra is installed.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Market data providers (optional — free sources work with no keys) ───────
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# TIINGO_API_KEY=
# FMP_API_KEY=

# ── Broker credentials (optional; read-only + paper first — live trading is
#    additionally gated by vibe's own mandate system AND is not proxied by the
#    qlib API). Uncomment what you use. ──────────────────────────────────────
# Interactive Brokers (via [ibkr] extra; needs IB Gateway/TWS reachable):
# IBKR_HOST=host.docker.internal
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1
# Alpaca (paper keys from https://app.alpaca.markets):
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
# Binance / OKX (or any ccxt exchange):
# BINANCE_API_KEY=
# BINANCE_SECRET=
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSWORD=
