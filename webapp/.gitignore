# Scoped to the webapp so the upstream qlib .gitignore stays untouched.

# Secrets — EODHD + OpenRouter keys.
.env

# Local state, with two exceptions. Everything under data/ is either generated by
# the ingest or produced by running the app -- except the strategies and portfolios,
# which are hand-authored and are the only part worth carrying between machines.
#
# catalog.json and store_manifest.json stay ignored on purpose: they are ingest
# output, and a stale catalog from another machine names tickers the local store
# does not carry. Search degrading to ticker-only until the ingest finishes is the
# more honest failure.
data/*
!data/strategies/
!data/portfolios/
ingest/.cache/

# Frontend
ui/node_modules/
ui/dist/
ui/.vite/
ui/*.tsbuildinfo
ui/test-results/
ui/playwright-report/

__pycache__/
.pytest_cache/
