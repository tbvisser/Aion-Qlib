  "refused": [
    {
      "name": "ChangeInstrument",
      "summary": "Evaluate a feature against a different instrument.",
      "reason": "Takes a quoted instrument name, and the canvas has no slot kind for a string -- every slot is a series, a window or a number."
    },
    {
      "name": "Rolling",
      "summary": "The generic rolling operator every other one is built on.",
      "reason": "Its `func` argument names the statistic, and qlib's own __str__ drops it -- Rolling($close,5,\"mean\") renders as Rolling($close,5), which cannot be read back. Use the named operator instead."
    },
    {
      "name": "Mask",
      "summary": "Read a feature from one named instrument.",
      "reason": "Renders the instrument unquoted and lower-cased, so Mask($close,'SH600000') reads back as a NameError rather than an expression."
    },
    {
      "name": "Feature",
      "summary": "A raw column, written $name.",
      "reason": "This is the leaf itself. The canvas draws it as a field card, not as an operator."
    },
    {
      "name": "PFeature",
      "summary": "A point-in-time field, written $$name.",
      "reason": "Needs point-in-time data that no store on this machine holds."
    },
    {
      "name": "TResample",
      "summary": "Resample to another frequency.",
      "reason": "Renders as TResample($close,1d) -- both the unquoted frequency and the dropped `func` make it unreadable, and these stores are daily."
    }
  ]
