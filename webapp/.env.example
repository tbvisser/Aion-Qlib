# Copy to webapp/.env and fill in. webapp/.env is gitignored — never commit keys.

# EODHD (market data). https://eodhd.com/cp/dashboard
EODHD_API_KEY=

# OpenRouter (chat). https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Which qlib binary store the API serves. The ingest builds the first one;
# the bundled CN dataset is used as a fallback until it exists.
PROVIDER_URI=~/.qlib/qlib_data/us_eodhd
REGION=us

# Vibe-Trading sidecar (see vibe/README.md). VIBE_API_TOKEN must equal
# API_AUTH_KEY in vibe/.env — the proxy authenticates with it. The URLs are
# compose-network defaults; override only for native (non-docker) dev.
VIBE_API_TOKEN=
# VIBE_API_URL=http://127.0.0.1:8899
# VIBE_MCP_URL=http://127.0.0.1:8900/mcp

# --- Identity and per-user storage ------------------------------------------
# The API verifies Supabase access tokens and stores every user's strategies,
# portfolios, projects and runs in Postgres. Without these the API starts but
# rejects all requests, because there is no way to tell users apart.
#
# SUPABASE_URL is the Kong gateway of the local Supabase stack. From inside the
# api container that is host.docker.internal; natively it is localhost.
SUPABASE_URL=http://host.docker.internal:8010
# Public by design — the browser holds this key too. Copy ANON_KEY from the
# infra/supabase/.env (the same value as VITE_SUPABASE_ANON_KEY).
SUPABASE_ANON_KEY=
# Copy SERVICE_ROLE_KEY from the same file. Secret — grants full data access.
SUPABASE_SERVICE_ROLE_KEY=
#
# Must connect as `authenticator`, never `postgres`: only a role that cannot
# bypass row level security can be trusted to serve one user's data without
# leaking another's. Password is POSTGRES_PASSWORD from infra/supabase/.env.
# Host is the database container, reachable because api and Supabase share
# aion-qlib_default; natively use 127.0.0.1:5442.
DATABASE_URL=postgresql://authenticator:CHANGEME@supabase-db-aq:5432/postgres

# --- Scalability agent (compose service `agent`) ------------------------------
# Background worker that polls aion.scalability_jobs and runs the scalability
# analysis engine (see venue-scalability-tool/). It reads the same Supabase and
# DATABASE_URL settings above; the tunables below all have sane defaults, so
# they stay commented out unless you want to change behavior.
# AGENT_POLL_SECONDS=5        # idle poll interval for the jobs queue
# AGENT_WORKERS=2             # jobs in flight per replica
# AGENT_LEASE_SECONDS=300     # job lease length; expired leases are re-queued
# AGENT_HEARTBEAT_SECONDS=30  # heartbeat cadence while a job runs
# AGENT_MAX_ATTEMPTS=3        # retry budget before a job is marked failed
# AGENT_PORT=8771             # health-endpoint port — the only inbound API
# Where the API reaches the agent's /health for the Agents & Skills roster.
# Compose-network default is http://agent:8771 (see webapp/api/config.py).
# Override only for native (non-docker) dev:
# SCALABILITY_AGENT_URL=http://127.0.0.1:8771

# --- Aion MCP server (optional, compose service aion-mcp) -------------------
# Streamable-HTTP MCP exposing allowlisted qlib tools for Hermes and other
# MCP hosts. Start with:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d aion-mcp
# AION_MCP_TOKEN=
# AION_MCP_URL=http://127.0.0.1:8910/mcp
# AION_MCP_SERVICE_USER_ID=   # optional UUID; enables list_runs / scalability reads
# AION_MCP_SERVICE_ORG_ID=    # optional; resolved from DB when omitted

# --- Hermes gateway (optional, compose service hermes-gateway) ---------------
# When false (default), the Agents & Skills roster skips the Hermes provider.
HERMES_GATEWAY_ENABLED=false
# HERMES_GATEWAY_URL=http://hermes-gateway:8642   # API probe (compose network)
# HERMES_BRIDGE_TOKEN=            # Hermes → POST /api/hermes/bridge/scheduled-tasks
# AION_MCP_USER_TOKEN_SECRET=     # optional; defaults to AION_MCP_TOKEN for user tokens
