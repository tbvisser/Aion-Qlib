# Copy to webapp/.env and fill in. webapp/.env is gitignored — never commit keys.

# EODHD (market data). https://eodhd.com/cp/dashboard
EODHD_API_KEY=

# OpenRouter (chat). https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Which qlib binary store the API serves. The ingest builds the first one;
# the bundled CN dataset is used as a fallback until it exists.
PROVIDER_URI=~/.qlib/qlib_data/us_eodhd
REGION=us

# Vibe-Trading sidecar (see vibe/README.md). VIBE_API_TOKEN must equal
# API_AUTH_KEY in vibe/.env — the proxy authenticates with it. The URLs are
# compose-network defaults; override only for native (non-docker) dev.
VIBE_API_TOKEN=
# VIBE_API_URL=http://127.0.0.1:8899
# VIBE_MCP_URL=http://127.0.0.1:8900/mcp

# --- Identity and per-user storage ------------------------------------------
# The API verifies Supabase access tokens and stores every user's strategies,
# portfolios, projects and runs in Postgres. Without these the API starts but
# rejects all requests, because there is no way to tell users apart.
#
# SUPABASE_URL is the Kong gateway of the supabase-aq stack. From inside the
# api container that is host.docker.internal; natively it is localhost.
SUPABASE_URL=http://host.docker.internal:8010
# Public by design — the browser holds this key too. Copy ANON_KEY from the
# supabase-aq project's .env (the same value as VITE_SUPABASE_ANON_KEY).
SUPABASE_ANON_KEY=
# Copy SERVICE_ROLE_KEY from the same file. Secret — grants full data access.
SUPABASE_SERVICE_ROLE_KEY=
#
# Must connect as `authenticator`, never `postgres`: only a role that cannot
# bypass row level security can be trusted to serve one user's data without
# leaking another's. Password is POSTGRES_PASSWORD from the supabase-aq .env.
# Host is the database container, reachable because the api service joins the
# supabase-aq_default network; natively use 127.0.0.1:5442.
DATABASE_URL=postgresql://authenticator:CHANGEME@supabase-db-aq:5432/postgres
