# ==============================================================================
# Supabase
# ==============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed for LEGACY symmetric (HS256) token signing. Newer self-hosted
# Supabase signs with asymmetric keys (ES256) — the backend then verifies via the
# JWKS endpoint automatically and you can leave this blank. For HS256 mode, set it
# to the JWT_SECRET from your supabase docker .env (Cloud: Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=

# ==============================================================================
# LLM — primary chat model (required)
# Uses OpenAI-compatible API. For OpenRouter, set the base URL accordingly.
# ==============================================================================

LLM_MODEL=gpt-4o
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-llm-api-key
LLM_CONTEXT_WINDOW=128000
# LLM_MODEL above is the DEFAULT — the in-app composer "Model" menu can override
# the model name per message and toggle "thinking" (reasoning). LLM_REASONING_STYLE
# controls how that thinking toggle maps to a provider param on the
# OpenAI-compatible path (Codex uses CODEX_REASONING_EFFORT instead):
#   auto       — infer from LLM_BASE_URL (openrouter -> reasoning.effort,
#                openai -> reasoning_effort, anything else e.g. LMStudio -> omit)
#   openrouter — always send reasoning.effort (OpenRouter's unified field)
#   openai     — always send top-level reasoning_effort
#   none       — never send a reasoning param (let local <think> models handle it)
LLM_REASONING_STYLE=auto

# Sub-agent LLM (optional — falls back to primary LLM when empty)
# Use a cheaper/faster model for harness sub-agents (batch agents, phase agents)
# while keeping the expensive model for the main chat orchestrator.
SUB_AGENT_MODEL=
SUB_AGENT_BASE_URL=
SUB_AGENT_API_KEY=

# Maximum agentic loop rounds (each round can contain multiple parallel tool calls)
MAX_TOOL_ROUNDS=25

# Maximum deep mode rounds (autonomous task execution with planning)
MAX_DEEP_ROUNDS=50

# ==============================================================================
# Codex provider — use a ChatGPT/Codex subscription for inference (optional)
# ==============================================================================
# Set LLM_PROVIDER=codex to route the PRIMARY chat + the deep/explorer/sub-agent
# loops through your ChatGPT subscription instead of LLM_BASE_URL/LLM_API_KEY.
# Leave empty (or "openrouter"/"openai") for the default OpenAI-compatible path.
#
# Prerequisites (one-time):
#   1) npm i -g @openai/codex
#   2) codex login            # writes ~/.codex/auth.json (tokens auto-refresh)
#
# IMPORTANT:
#   - Keep LLM_* configured (e.g. OpenRouter): it still powers EMBEDDINGS and all
#     high-volume utility calls (PII redaction, metadata extraction, compaction,
#     thread-title generation). Those never use Codex, to protect your
#     subscription's limited rolling message quota.
#   - When LLM_PROVIDER=codex, analyze/explorer/task sub-agents use CODEX_MODEL
#     with medium reasoning. SUB_AGENT_* applies to the OpenAI-compatible path.
#   - CODEX_MODEL must be a model your plan can access (matches `model` in
#     ~/.codex/config.toml, e.g. gpt-5.5).
#   - The Codex backend is an undocumented endpoint and may change without notice.
LLM_PROVIDER=
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=
# Reasoning summary surfaced in the chat's "Thought process" panel when the
# composer's thinking toggle is on: auto | concise | detailed | "" (off).
# Set to "" if your Codex backend rejects the reasoning.summary parameter.
CODEX_REASONING_SUMMARY=auto
# CODEX_HOME=                                       # override ~/.codex location
# CODEX_BASE_URL=https://chatgpt.com/backend-api/codex

# ==============================================================================
# Embedding (required)
# Model used to embed document chunks for vector search.
# ==============================================================================

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_DIMENSIONS=1536

# Document chunking: "smart" preserves Markdown hierarchy; "simple" is a recursive char splitter.
CHUNKING_STRATEGY=smart

# Document ingestion / Docling resource limits.
# Keep enabled: native PDF/OCR libraries can crash the interpreter on bad files
# or memory pressure; isolation keeps the API alive and fails only that document.
INGESTION_PROCESS_ISOLATION_ENABLED=true
# Increase DOCLING_MAX_CONCURRENT_CONVERSIONS on high-RAM machines after testing;
# lower it, DOCLING_BATCH_SIZE, or DOCLING_NUM_THREADS if Docling logs
# std::bad_alloc during PDF preprocessing.
INGESTION_MAX_CONCURRENT_DOCUMENTS=4
DOCLING_MAX_CONCURRENT_CONVERSIONS=1
DOCLING_DEVICE=auto
DOCLING_NUM_THREADS=8
DOCLING_BATCH_SIZE=1
DOCLING_TABLE_BATCH_SIZE=4
DOCLING_QUEUE_MAX_SIZE=8
DOCLING_DO_OCR=true
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_TABLE_MODE=accurate
DOCLING_OCR_MODE=auto
DOCLING_FORCE_FULL_PAGE_OCR=false
DOCLING_OCR_AUTO_MAX_PAGES=50
DOCLING_OCR_AUTO_MIN_CHARS_PER_PAGE=60
DOCLING_OCR_AUTO_MIN_READABLE_PAGE_RATIO=0.8
DOCLING_OCR_AUTO_MIN_TEXT_AREA_RATIO=0.01
DOCLING_OCR_AUTO_MIN_TEXT_DENSITY=40
DOCLING_OCR_AUTO_MIN_VISUAL_AREA_RATIO=0.2
DOCLING_OCR_BACKEND=auto
# PDF backend: docling_parse, threaded_docling_parse, or pypdfium2.
DOCLING_PDF_BACKEND=docling_parse
# Split large PDFs into page windows before stitching extracted text/layout back
# together. 0 disables page-window chunking.
DOCLING_MAX_PAGES_PER_CHUNK=50
# Allow multiple page windows from the same PDF to run at once. Every window
# still consumes one global DOCLING_MAX_CONCURRENT_CONVERSIONS slot.
DOCLING_MAX_PARALLEL_PAGE_CHUNKS_PER_DOCUMENT=1
# Recovery path for scanned/image-only PDFs where Docling invokes OCR but still
# emits blank or suspiciously sparse markdown. Renders pages and runs RapidOCR directly.
DOCLING_OCR_BLANK_FALLBACK_ENABLED=true
DOCLING_OCR_BLANK_FALLBACK_SCALE=3.0
DOCLING_OCR_SPARSE_FALLBACK_MIN_CHARS_PER_PAGE=120
# Recovery path for machine-readable PDFs where Docling emits much less text
# than PDFium can see in the embedded text layer.
DOCLING_PDF_TEXT_LAYER_FALLBACK_ENABLED=true
DOCLING_PDF_TEXT_LAYER_FALLBACK_MIN_CHARS=200
DOCLING_PDF_TEXT_LAYER_FALLBACK_MIN_RATIO=0.5
METADATA_EXTRACTION_TIMEOUT_SECONDS=45
#
# OCR modes:
#   auto   = preflight PDFs and disable OCR when sampled pages have a dense
#            enough text layer by characters, text-area coverage, and page density.
#   always = Docling hybrid OCR; existing selectable text is preserved unless
#            DOCLING_FORCE_FULL_PAGE_OCR=true.
#   never  = disable OCR entirely; fastest, but scanned PDFs will not transcribe.
# Sparse text on a visual-heavy page (for example, a selectable title over a
# full-page image) is treated as not machine-readable and uses full-page OCR.
#
# RTX fast profile after installing a CUDA-enabled PyTorch build:
# DOCLING_DEVICE=cuda
# DOCLING_BATCH_SIZE=64
# DOCLING_TABLE_BATCH_SIZE=4
# DOCLING_QUEUE_MAX_SIZE=100
# DOCLING_TABLE_MODE=fast
# DOCLING_OCR_MODE=auto
# DOCLING_OCR_BACKEND=torch
# DOCLING_PDF_BACKEND=threaded_docling_parse
# DOCLING_MAX_CONCURRENT_CONVERSIONS=1  # safest for multi-PDF drops; raise only after benchmarking
#
# Workstation parallel profile for large PDFs / multi-file drops:
# INGESTION_MAX_CONCURRENT_DOCUMENTS=8
# DOCLING_MAX_CONCURRENT_CONVERSIONS=4
# DOCLING_NUM_THREADS=6
# DOCLING_MAX_PAGES_PER_CHUNK=25
# DOCLING_MAX_PARALLEL_PAGE_CHUNKS_PER_DOCUMENT=2
#
# Max-throughput variant if table structure is not important:
# DOCLING_DO_TABLE_STRUCTURE=false

# ==============================================================================
# Reranking (optional)
# Cohere-compatible reranking endpoint. Leave RERANK_BASE_URL empty to disable.
# ==============================================================================

RERANK_MODEL=rerank-v3.5
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_TOP_N=5

# ==============================================================================
# Web Search (optional)
# Adds a web_search tool to the chat agent. Currently supports Tavily.
# Set WEB_SEARCH_ENABLED=true and provide an API key to activate.
# ==============================================================================

WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENABLED=false

# ==============================================================================
# Remote Skill Import (optional)
# "Import from URL" in the Skills page pulls skills from public GitHub repos
# (e.g. skills.sh). A personal access token is only needed to raise GitHub's
# rate limit (60 -> 5000/hr) or to import from private repos.
# ==============================================================================

GITHUB_TOKEN=

# ==============================================================================
# SQL Agent (optional)
# Read-only Postgres connection for text-to-SQL queries against a sales_data table.
# Format: postgresql://sql_reader:password@host:5432/postgres
# Generate the role password + this connection string with:
#   powershell -File scripts/rotate-sql-reader-password.ps1
# (The demo tables it reads are an optional import — see scripts/import-demo-content.ps1.)
# ==============================================================================

SQL_READER_DATABASE_URL=

# ==============================================================================
# PII Redaction
# Controls the Presidio-based anonymization pipeline.
# Set PII_REDACTION_ENABLED=false to bypass the entire pipeline.
# ==============================================================================

PII_REDACTION_ENABLED=false

# Resolution strategy for mapping detected PII to Faker surrogates.
# "llm" = use local LLM for fuzzy matching, "algorithmic" = heuristics, "none" = skip
ENTITY_RESOLUTION_MODE=llm

# Entity types that get reversible Faker surrogates (can be de-anonymized)
PII_SURROGATE_ENTITIES=PERSON,EMAIL_ADDRESS,PHONE_NUMBER,LOCATION,DATE_TIME,URL,IP_ADDRESS

# Entity types that get hard-redacted with [TYPE] placeholders (never reversed)
PII_REDACT_ENTITIES=CREDIT_CARD,US_SSN,US_ITIN,US_BANK_NUMBER,IBAN_CODE,CRYPTO,US_PASSPORT,US_DRIVER_LICENSE,MEDICAL_LICENSE

# Presidio confidence thresholds (0.0 - 1.0)
# Surrogate: higher threshold to avoid false positives on names, emails, etc.
# Hard-redact: lower threshold — false positives are cheap, false negatives leak PII.
PII_SURROGATE_SCORE_THRESHOLD=0.7
PII_REDACT_SCORE_THRESHOLD=0.3

# Local LLM for PII entity resolution and metadata extraction (optional)
# Point to a local LM Studio / Ollama endpoint.
LOCAL_LLM_MODEL=
LOCAL_LLM_BASE_URL=

# Secondary LLM scan for hard-redact PII that Presidio missed.
# Requires local LLM configured above. Set to false to disable.
PII_MISSED_SCAN_ENABLED=true

# ==============================================================================
# Observability (optional)
# Set TRACING_PROVIDER to "langsmith" or "langfuse" to enable trace export.
# Leave empty to disable tracing.
# ==============================================================================

TRACING_PROVIDER=

# LangSmith
LANGSMITH_API_KEY=ls-your-key
LANGSMITH_PROJECT=rag-masterclass

# Langfuse (when TRACING_PROVIDER=langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-your-key
LANGFUSE_SECRET_KEY=sk-lf-your-key
LANGFUSE_HOST=http://localhost:3001

# ==============================================================================
# Misc
# ==============================================================================

# ==============================================================================
# Code Sandbox (optional)
# Docker-based sandboxed code execution for skills that generate files.
# Requires Docker running locally. Set SANDBOX_ENABLED=true to activate.
# ==============================================================================

SANDBOX_ENABLED=false
SANDBOX_MAX_EXECUTION_TIME=60
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_SESSION_TTL_MINUTES=30
SANDBOX_CONTAINER_IMAGE=sandbox-python:latest  # Build with: docker build -t sandbox-python:latest backend/sandbox/
SANDBOX_MAX_CONCURRENT_SESSIONS=5

# ==============================================================================
# Tool Registry (optional)
# Unified tool registry with dynamic tool discovery via tool_search.
# ==============================================================================

TOOL_REGISTRY_ENABLED=false
CATALOG_MAX_TOOLS=50

# ==============================================================================
# Sandbox HTTP Bridge (optional, requires TOOL_REGISTRY_ENABLED=true)
# Allows sandbox code to call tools via HTTP bridge endpoint.
# ==============================================================================

BRIDGE_PORT=8002
BRIDGE_SESSION_TOKEN_TTL_MINUTES=30

# ==============================================================================
# MCP Servers (optional, Phase 3)
# Comma-separated "name:command:args" entries for MCP server connections.
# Defers loading by default unless you include "loading":"immediate"
# Example: github:npx:-y @modelcontextprotocol/server-github
# ==============================================================================

GITHUB_PERSONAL_ACCESS_TOKEN=
MCP_SERVERS=[]
# MCP_SERVERS='[{"name":"github","command":"npx","args":["-y","@modelcontextprotocol/server-github"],"loading":"immediate"},{"name":"slack","command":"npx","args":["-y","@modelcontextprotocol/server-slack"]}]'
CORS_ORIGINS=["http://localhost:5173"]

# ==============================================================================
# Test users (backend pytest API suite + frontend Playwright E2E)
# The suites log in as these two accounts. Set the real passwords in your own
# backend/.env (gitignored) — never commit them or put them in CLAUDE.md.
# TEST_USER1 should be the admin account; TEST_USER2 a non-admin (isolation tests).
# ==============================================================================

TEST_USER1_EMAIL=test@test.com
TEST_USER1_PASSWORD=
TEST_USER2_EMAIL=test2@test.com
TEST_USER2_PASSWORD=

