# Compose-level settings. Copy to `.env` (gitignored) if you need to change any.
# Application secrets do NOT go here — those live in webapp/.env (see
# webapp/.env.example). This file is only read by docker compose itself.

# Which image the python services run (api + scalability agent).
#   unset / default  -> pull the image CI publishes to GHCR
#   qlib-dev:local   -> use your own `docker compose build api` output
# AION_IMAGE=qlib-dev:local
# AION_RAG_IMAGE=aion-rag:dev
# AION_VIBE_IMAGE=aion-vibe:dev

# Linux only. The containers bind-mount this repo and write into it (run records,
# examples/mlruns, recompiled .so files). Left at the default of 0, they write as
# root and your host user cannot then edit or delete those files. macOS Docker
# Desktop remaps ownership for you, so leave these unset there.
#
#   printf 'DOCKER_UID=%s\nDOCKER_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# DOCKER_UID=1000
# DOCKER_GID=1000
